# Orchestra Configuration
MCP_PORT=3456
LOG_LEVEL=info

# Archon Connection
ARCHON_URL=http://localhost:8000

# Agent API Keys (optional - for direct API calls)
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# GitHub MCP Server Configuration
GITHUB_PAT=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
GITHUB_MCP_ENABLED=true
GITHUB_MCP_MODE=binary  # Options: docker | binary
GITHUB_MCP_PORT=8054

# Performance Settings
MAX_CONCURRENT_TASKS=10
TASK_TIMEOUT_MS=300000

# Feature Flags
ENABLE_LEARNING=true
ENABLE_METRICS=true
ENABLE_PERSISTENCE=true
ENABLE_GITHUB_INTEGRATION=true

# Jules MCP Configuration (Hybrid Workflow)
JULES_WORKSPACE_REPO=archon-jules-workspace
JULES_SESSION_MODE=cookies
JULES_HEADLESS=true
JULES_DEBUG=false
JULES_DATA_PATH=/Users/manu/.jules-mcp/data.json

# Google Auth Cookies (get from jules.google.com)
# GOOGLE_AUTH_COOKIES="session_id=abc123; domain=.google.com; auth_token=xyz789; domain=.google.com"
