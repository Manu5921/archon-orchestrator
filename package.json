{
  "name": "archon-orchestrator",
  "version": "1.0.0",
  "description": "Triple-Agent Orchestra: Archon + Gemini + Claude coordination system",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/validate-project-structure.js",
    "lint": "eslint . --ext .js,.mjs,.cjs --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.mjs,.cjs --fix",
    "dev": "node --watch src/index.js",
    "start": "node src/lighthouse-server.js",
    "start:orchestra": "node src/index.js",
    "mcp:server": "node src/mcp/start-server.js",
    "connect:gemini": "node src/agents/gemini-connector.js",
    "connect:claude": "node src/agents/claude-connector.js",
    "knowledge:sync": "node src/knowledge/sync.js",
    "test": "pnpm test:unit",
    "test:real": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathIgnorePatterns=/tests/e2e/",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch --testPathIgnorePatterns=/tests/e2e/",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --testPathIgnorePatterns=/tests/e2e/",
    "test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --ci --reporters=default --reporters=jest-junit --testPathIgnorePatterns=/tests/e2e/",
    "test:debug": "NODE_OPTIONS='--experimental-vm-modules --inspect-brk' jest --runInBand --testPathIgnorePatterns=/tests/e2e/",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:widget": "playwright test tests/e2e/widget/ --project=chromium-desktop",
    "test:dashboard": "playwright test tests/e2e/dashboard/ --project=chromium-desktop",
    "test:performance": "playwright test tests/e2e/performance/ --project=performance-monitoring",
    "test:security": "playwright test tests/e2e/security/ --project=chromium-desktop",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:cross-browser": "playwright test --project=chromium-desktop --project=firefox-desktop --project=webkit-desktop",
    "test:all": "playwright test --project=chromium-desktop --project=firefox-desktop --project=webkit-desktop --project=mobile-chrome --project=mobile-safari",
    "test:a11y": "NODE_OPTIONS='--experimental-vm-modules' jest --testMatch='**/*.a11y.test.{js,jsx,ts,tsx}' --testPathIgnorePatterns=/tests/e2e/",
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect",
    "lighthouse:assert": "lhci assert",
    "lighthouse:upload": "lhci upload",
    "test:all-with-unit": "npm run test:coverage && npm run test:e2e",
    "quality:gate": "node scripts/quality-gate.js",
    "quality:check": "npm run test:coverage && npm run test:e2e && npm run quality:gate",
    "coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --testPathIgnorePatterns=/tests/e2e/",
    "coverage:report": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --coverageReporters=html --coverageReporters=lcov --coverageReporters=text --testPathIgnorePatterns=/tests/e2e/",
    "coverage:open": "npm run coverage:report && open coverage/lcov-report/index.html",
    "coverage:threshold": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --coverageThreshold='{}' --testPathIgnorePatterns=/tests/e2e/",
    "playwright:install": "playwright install --with-deps",
    "playwright:update": "playwright install --force",
    "health": "curl -f http://localhost:3000/health || echo 'Server not running'"
  },
  "keywords": [
    "ai",
    "orchestration",
    "mcp",
    "archon",
    "gemini",
    "claude",
    "agent-coordination"
  ],
  "author": "Triple-Agent Orchestra Team",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "axios": "^1.7.8",
    "dotenv": "^16.6.1",
    "eventsource": "^4.0.0",
    "express": "^4.21.1",
    "ioredis": "^5.4.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "p-limit": "^7.1.1",
    "sqlite3": "^5.1.7",
    "uuid": "^11.0.3",
    "winston": "^3.17.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@jest/globals": "^30.1.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.1",
    "axe-core": "^4.10.3",
    "babel-jest": "^30.1.2",
    "c8": "^10.1.3",
    "eslint": "^9.37.0",
    "jest": "^30.1.3",
    "jest-axe": "^10.0.0",
    "jest-environment-node": "^30.1.2",
    "jest-junit": "^16.0.0",
    "lighthouse": "^12.8.2",
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}