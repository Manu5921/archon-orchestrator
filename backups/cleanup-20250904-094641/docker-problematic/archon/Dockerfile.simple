# Archon Orchestrator Main Dockerfile - Simplified
FROM node:18-alpine

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache curl git

# Copy all files directly (simpler than npm install for testing)
COPY . .

# Create necessary directories
RUN mkdir -p /app/logs /app/data /app/temp

# Health check endpoint
EXPOSE 3456 8080

# Simple startup script
RUN echo '#!/bin/sh' > /app/docker-start.sh && \
    echo 'echo "🎭 Starting Archon Orchestrator..."' >> /app/docker-start.sh && \
    echo 'echo "✅ Node.js: $(node --version)"' >> /app/docker-start.sh && \
    echo 'echo "✅ Working directory: $(pwd)"' >> /app/docker-start.sh && \
    echo 'echo "✅ Files available:"' >> /app/docker-start.sh && \
    echo 'ls -la | head -10' >> /app/docker-start.sh && \
    echo 'echo "🎯 Starting Jules Hybrid Deploy..."' >> /app/docker-start.sh && \
    echo 'exec node jules-hybrid-deploy.js daemon' >> /app/docker-start.sh && \
    chmod +x /app/docker-start.sh

# Non-root user for security
RUN adduser -D -s /bin/sh appuser
RUN chown -R appuser:appuser /app
USER appuser

CMD ["./docker-start.sh"]