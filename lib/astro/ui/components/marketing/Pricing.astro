---
/**
 * Pricing Component
 *
 * Purpose: Pricing table with 3 tiers
 * Philosophy: Design/Dev Decoupling (uses design-tokens.css variables)
 *
 * Usage:
 * ```astro
 * <Pricing
 *   title="Simple, Transparent Pricing"
 *   plans={[
 *     {
 *       name: 'Pro',
 *       price: { amount: 29, currency: '$', interval: 'month' },
 *       features: ['Unlimited pages', 'Priority support'],
 *       cta: { label: 'Get Started', href: '/signup', variant: 'primary' },
 *       badge: 'Popular',
 *       highlighted: true
 *     }
 *   ]}
 * />
 * ```
 */

interface Price {
  amount: number;
  currency?: string;
  interval?: 'month' | 'year';
}

interface CTA {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary';
}

interface Plan {
  name: string;
  price: Price;
  features: string[];
  cta: CTA;
  badge?: string;
  highlighted?: boolean;
}

interface Props {
  title?: string;
  description?: string;
  plans: Plan[];
  class?: string;
}

const {
  title,
  description,
  plans,
  class: className
} = Astro.props;
---

<section class={`pricing ${className || ''}`}>
  <div class="pricing-container">
    {/* Header (optional) */}
    {(title || description) && (
      <div class="pricing-header">
        {title && <h2 class="pricing-title">{title}</h2>}
        {description && <p class="pricing-description">{description}</p>}
      </div>
    )}

    {/* Plans Grid */}
    <div class="plans-grid">
      {plans.map((plan) => (
        <div class={`plan-card ${plan.highlighted ? 'highlighted' : ''}`}>
          {plan.badge && (
            <span class="plan-badge">{plan.badge}</span>
          )}

          <h3 class="plan-name">{plan.name}</h3>

          <div class="plan-price">
            <span class="price-currency">{plan.price.currency || '$'}</span>
            <span class="price-amount">{plan.price.amount}</span>
            {plan.price.interval && (
              <span class="price-interval">/{plan.price.interval}</span>
            )}
          </div>

          <ul class="plan-features">
            {plan.features.map((feature) => (
              <li class="feature-item">
                <svg class="check-icon" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6L9 17l-5-5" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>

          <a
            href={plan.cta.href}
            class={`plan-cta ${plan.cta.variant || 'primary'}`}
          >
            {plan.cta.label}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing {
    padding: var(--space-16) 0;
    background-color: var(--color-neutral-50);
  }

  .pricing-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .pricing-header {
    text-align: center;
    max-width: 768px;
    margin: 0 auto var(--space-12);
  }

  .pricing-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--color-neutral-950);
    margin-bottom: var(--space-4);
  }

  .pricing-description {
    font-size: var(--text-xl);
    color: var(--color-neutral-600);
    line-height: var(--leading-relaxed);
  }

  .plans-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .plans-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .plan-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-8);
    background-color: white;
    border: var(--border-2) solid var(--color-neutral-200);
    border-radius: var(--radius-2xl);
    transition: var(--transition-all);
  }

  .plan-card:hover {
    border-color: var(--color-primary-300);
    box-shadow: var(--shadow-xl);
    transform: translateY(-4px);
  }

  .plan-card.highlighted {
    border-color: var(--color-primary-500);
    box-shadow: var(--shadow-lg);
    transform: scale(1.05);
  }

  .plan-badge {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-primary-500);
    color: white;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    border-radius: var(--radius-full);
    text-transform: uppercase;
  }

  .plan-name {
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    color: var(--color-neutral-900);
    margin: 0;
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
  }

  .price-currency {
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    color: var(--color-neutral-700);
  }

  .price-amount {
    font-size: var(--text-5xl);
    font-weight: var(--font-bold);
    color: var(--color-neutral-950);
  }

  .price-interval {
    font-size: var(--text-lg);
    color: var(--color-neutral-600);
  }

  .plan-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex-grow: 1;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    color: var(--color-neutral-700);
  }

  .check-icon {
    flex-shrink: 0;
    color: var(--color-primary-600);
  }

  .plan-cta {
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    border-radius: var(--radius-lg);
    text-decoration: none;
    text-align: center;
    transition: var(--transition-all);
    cursor: pointer;
  }

  .plan-cta.primary {
    background-color: var(--color-primary-600);
    color: white;
    border: none;
  }

  .plan-cta.primary:hover {
    background-color: var(--color-primary-700);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .plan-cta.secondary {
    background-color: transparent;
    color: var(--color-primary-600);
    border: var(--border-2) solid var(--color-primary-600);
  }

  .plan-cta.secondary:hover {
    background-color: var(--color-primary-50);
  }

  @media (prefers-color-scheme: dark) {
    .pricing {
      background-color: var(--color-neutral-900);
    }

    .pricing-title {
      color: var(--color-neutral-50);
    }

    .pricing-description {
      color: var(--color-neutral-400);
    }

    .plan-card {
      background-color: var(--color-neutral-800);
      border-color: var(--color-neutral-700);
    }

    .plan-card.highlighted {
      border-color: var(--color-primary-500);
    }

    .plan-name {
      color: var(--color-neutral-100);
    }

    .price-amount {
      color: var(--color-neutral-50);
    }

    .feature-item {
      color: var(--color-neutral-300);
    }
  }
</style>
