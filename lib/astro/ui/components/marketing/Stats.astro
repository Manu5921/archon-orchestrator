---
/**
 * Stats Component
 *
 * Purpose: Statistics showcase (metrics, numbers, social proof)
 * Philosophy: Design/Dev Decoupling (uses design-tokens.css variables)
 *
 * Usage:
 * ```astro
 * <Stats
 *   title="Trusted by Thousands"
 *   stats={[
 *     { value: '10K+', label: 'Active Users' },
 *     { value: '99.9%', label: 'Uptime' },
 *     { value: '50M+', label: 'API Calls' }
 *   ]}
 *   layout="horizontal"
 * />
 * ```
 */

interface Stat {
  value: string;    // Stat value (e.g., "10K+", "99.9%")
  label: string;    // Stat label
  icon?: string;    // Optional icon (emoji or SVG)
}

interface Props {
  title?: string;
  description?: string;
  stats: Stat[];
  layout?: 'horizontal' | 'grid';
  class?: string;
}

const {
  title,
  description,
  stats,
  layout = 'horizontal',
  class: className
} = Astro.props;
---

<section class={`stats ${className || ''}`}>
  <div class="stats-container">
    {/* Header (optional) */}
    {(title || description) && (
      <div class="stats-header">
        {title && <h2 class="stats-title">{title}</h2>}
        {description && <p class="stats-description">{description}</p>}
      </div>
    )}

    {/* Stats Layout */}
    <div class={`stats-${layout}`}>
      {stats.map((stat) => (
        <div class="stat-item">
          {stat.icon && <div class="stat-icon">{stat.icon}</div>}
          <div class="stat-value">{stat.value}</div>
          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats {
    padding: var(--space-16) 0;
    background-color: var(--color-neutral-50);
  }

  .stats-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .stats-header {
    text-align: center;
    max-width: 768px;
    margin: 0 auto var(--space-12);
  }

  .stats-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--color-neutral-950);
    margin-bottom: var(--space-4);
  }

  .stats-description {
    font-size: var(--text-xl);
    color: var(--color-neutral-600);
    line-height: var(--leading-relaxed);
  }

  /* Horizontal Layout */
  .stats-horizontal {
    display: flex;
    justify-content: space-around;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  /* Grid Layout */
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .stat-icon {
    font-size: var(--text-3xl);
    line-height: 1;
  }

  .stat-value {
    font-size: var(--text-5xl);
    font-weight: var(--font-extrabold);
    color: var(--color-primary-600);
    line-height: var(--leading-none);
  }

  @media (min-width: 768px) {
    .stat-value {
      font-size: var(--text-6xl);
    }
  }

  .stat-label {
    font-size: var(--text-base);
    color: var(--color-neutral-600);
    font-weight: var(--font-medium);
  }

  @media (prefers-color-scheme: dark) {
    .stats {
      background-color: var(--color-neutral-900);
    }

    .stats-title {
      color: var(--color-neutral-50);
    }

    .stats-description {
      color: var(--color-neutral-400);
    }

    .stat-value {
      color: var(--color-primary-400);
    }

    .stat-label {
      color: var(--color-neutral-400);
    }
  }
</style>
