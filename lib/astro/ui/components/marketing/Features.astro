---
/**
 * Features Component
 *
 * Purpose: Features grid (2/3/4-column responsive layout)
 * Philosophy: Design/Dev Decoupling (uses design-tokens.css variables)
 *
 * Usage:
 * ```astro
 * <Features
 *   title="Why Choose Us"
 *   description="Everything you need to launch faster"
 *   features={[
 *     { icon: '🚀', title: 'Lightning Fast', description: '0 KB JavaScript. Pure HTML performance.' },
 *     { icon: '🔍', title: 'SEO Optimized', description: 'Perfect Lighthouse scores out of the box.' }
 *   ]}
 *   columns={3}
 * />
 * ```
 */

interface Feature {
  icon: string;          // Emoji or SVG path
  title: string;
  description: string;
}

interface Props {
  title?: string;
  description?: string;
  features: Feature[];
  columns?: 2 | 3 | 4;
  class?: string;
}

const {
  title,
  description,
  features,
  columns = 3,
  class: className
} = Astro.props;
---

<section class={`features ${className || ''}`}>
  <div class="features-container">
    {/* Header (optional) */}
    {(title || description) && (
      <div class="features-header">
        {title && <h2 class="features-title">{title}</h2>}
        {description && <p class="features-description">{description}</p>}
      </div>
    )}

    {/* Features Grid */}
    <div class={`features-grid cols-${columns}`}>
      {features.map((feature) => (
        <div class="feature-card">
          <div class="feature-icon">{feature.icon}</div>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-description">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding: var(--space-16) 0;
    background-color: var(--color-neutral-50);
  }

  .features-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .features-header {
    text-align: center;
    max-width: 768px;
    margin: 0 auto var(--space-12);
  }

  .features-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--color-neutral-950);
    margin-bottom: var(--space-4);
  }

  .features-description {
    font-size: var(--text-xl);
    color: var(--color-neutral-600);
    line-height: var(--leading-relaxed);
  }

  .features-grid {
    display: grid;
    gap: var(--space-8);
  }

  /* Grid Columns - Mobile First */
  .features-grid {
    grid-template-columns: 1fr;
  }

  /* Tablet */
  @media (min-width: 768px) {
    .features-grid.cols-2 {
      grid-template-columns: repeat(2, 1fr);
    }

    .features-grid.cols-3,
    .features-grid.cols-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .features-grid.cols-3 {
      grid-template-columns: repeat(3, 1fr);
    }

    .features-grid.cols-4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background-color: white;
    border-radius: var(--radius-xl);
    border: var(--border-1) solid var(--color-neutral-200);
    transition: var(--transition-all);
  }

  .feature-card:hover {
    border-color: var(--color-primary-300);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .feature-icon {
    font-size: var(--text-4xl);
    line-height: 1;
  }

  .feature-title {
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    color: var(--color-neutral-900);
    margin: 0;
  }

  .feature-description {
    font-size: var(--text-base);
    color: var(--color-neutral-600);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  @media (prefers-color-scheme: dark) {
    .features {
      background-color: var(--color-neutral-900);
    }

    .features-title {
      color: var(--color-neutral-50);
    }

    .features-description {
      color: var(--color-neutral-400);
    }

    .feature-card {
      background-color: var(--color-neutral-800);
      border-color: var(--color-neutral-700);
    }

    .feature-card:hover {
      border-color: var(--color-primary-600);
    }

    .feature-title {
      color: var(--color-neutral-100);
    }

    .feature-description {
      color: var(--color-neutral-400);
    }
  }
</style>
