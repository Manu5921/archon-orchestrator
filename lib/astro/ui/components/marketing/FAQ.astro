---
/**
 * FAQ (Frequently Asked Questions) Component
 *
 * Purpose: Accordion-style Q&A section
 * Philosophy: Design/Dev Decoupling (uses design-tokens.css variables)
 * Note: Uses vanilla JS for accordion (no React island needed)
 *
 * Usage:
 * ```astro
 * <FAQ
 *   title="Frequently Asked Questions"
 *   faqs={[
 *     { question: 'Is this free?', answer: 'Yes! MIT licensed.' },
 *     { question: 'Can I customize?', answer: 'Absolutely. All styles use CSS variables.' }
 *   ]}
 *   layout="single"
 * />
 * ```
 */

interface FAQItem {
  question: string;
  answer: string;  // Supports HTML
}

interface Props {
  title?: string;
  description?: string;
  faqs: FAQItem[];
  layout?: 'single' | 'two-column';
  class?: string;
}

const {
  title,
  description,
  faqs,
  layout = 'single',
  class: className
} = Astro.props;
---

<section class={`faq ${className || ''}`}>
  <div class="faq-container">
    {/* Header (optional) */}
    {(title || description) && (
      <div class="faq-header">
        {title && <h2 class="faq-title">{title}</h2>}
        {description && <p class="faq-description">{description}</p>}
      </div>
    )}

    {/* FAQ Accordion */}
    <div class={`faq-${layout}`}>
      {faqs.map((faq, index) => (
        <details class="faq-item" id={`faq-${index}`}>
          <summary class="faq-question">
            {faq.question}
            <svg class="chevron" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </summary>
          <div class="faq-answer" set:html={faq.answer} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding: var(--space-16) 0;
    background-color: var(--color-neutral-50);
  }

  .faq-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .faq-header {
    text-align: center;
    max-width: 768px;
    margin: 0 auto var(--space-12);
  }

  .faq-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--color-neutral-950);
    margin-bottom: var(--space-4);
  }

  .faq-description {
    font-size: var(--text-xl);
    color: var(--color-neutral-600);
    line-height: var(--leading-relaxed);
  }

  /* Single Column Layout */
  .faq-single {
    max-width: 768px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Two Column Layout */
  .faq-two-column {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .faq-two-column {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }

  .faq-item {
    background-color: white;
    border: var(--border-1) solid var(--color-neutral-200);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: var(--transition-all);
  }

  .faq-item:hover {
    border-color: var(--color-primary-300);
    box-shadow: var(--shadow-md);
  }

  .faq-item[open] {
    border-color: var(--color-primary-500);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-6);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--color-neutral-900);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: var(--transition-colors);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    color: var(--color-primary-600);
  }

  .chevron {
    flex-shrink: 0;
    transition: var(--transition-transform);
  }

  .faq-item[open] .chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 var(--space-6) var(--space-4);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-neutral-700);
    animation: slideDown var(--transition-base) var(--ease-out);
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-color-scheme: dark) {
    .faq {
      background-color: var(--color-neutral-900);
    }

    .faq-title {
      color: var(--color-neutral-50);
    }

    .faq-description {
      color: var(--color-neutral-400);
    }

    .faq-item {
      background-color: var(--color-neutral-800);
      border-color: var(--color-neutral-700);
    }

    .faq-item[open] {
      border-color: var(--color-primary-500);
    }

    .faq-question {
      color: var(--color-neutral-100);
    }

    .faq-answer {
      color: var(--color-neutral-300);
    }
  }
</style>

<script>
  // Keyboard accessibility: Space/Enter to toggle
  document.querySelectorAll('.faq-question').forEach((summary) => {
    summary.addEventListener('keydown', (e) => {
      if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        (summary.parentElement as HTMLDetailsElement)?.toggleAttribute('open');
      }
    });
  });
</script>
