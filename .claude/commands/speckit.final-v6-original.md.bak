### Step 6: Final Validation

After all agents complete:

```bash
echo "🔍 Running final validation..."

# 1. Build check
pnpm build
if [ $? -ne 0 ]; then
  pulse.logCheckpoint('final_build', 'fail', { phase: 'final' });
  echo "❌ Final build failed"
  exit 1
fi
pulse.logCheckpoint('final_build', 'pass', { phase: 'final' });

# 2. Lint check
pnpm lint
if [ $? -ne 0 ]; then
  pulse.logCheckpoint('final_lint', 'fail', { phase: 'final' });
  echo "⚠️  Final lint has errors (review required)"
fi
pulse.logCheckpoint('final_lint', 'pass', { phase: 'final' });

# 3. Test suite
pnpm test
if [ $? -ne 0 ]; then
  pulse.logCheckpoint('final_test', 'fail', { phase: 'final' });
  echo "⚠️  Final tests have failures (review required)"
fi
pulse.logCheckpoint('final_test', 'pass', { phase: 'final' });

echo "✅ Final validation complete"
```

