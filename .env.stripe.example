# TrustBoost - Configuration Stripe
# AGENT BUSINESS - Variables environnement production
# CRITIQUE: Configurer en production pour sécurité

# ============================================
# STRIPE CONFIGURATION (REQUIRED)
# ============================================

# Clés Stripe (obtenir depuis https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Webhook secret (obtenir depuis https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ============================================
# PRICE IDs STRIPE (PLANS TRUSTBOOST)
# ============================================

# Plan Starter
STRIPE_PRICE_STARTER_MONTHLY=price_1234567890_starter_monthly
STRIPE_PRICE_STARTER_YEARLY=price_1234567890_starter_yearly

# Plan Professional  
STRIPE_PRICE_PRO_MONTHLY=price_1234567890_pro_monthly
STRIPE_PRICE_PRO_YEARLY=price_1234567890_pro_yearly

# Plan Enterprise
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_1234567890_enterprise_monthly
STRIPE_PRICE_ENTERPRISE_YEARLY=price_1234567890_enterprise_yearly

# ============================================
# CONFIGURATION GENERALE
# ============================================

# URL du site (pour redirections Stripe)
NEXT_PUBLIC_SITE_URL=https://trustboost.example.com

# Mode debug Stripe (development uniquement)
STRIPE_DEBUG=true

# Webhook endpoints (pour configuration)
STRIPE_WEBHOOK_URL=https://trustboost.example.com/api/stripe/webhook

# ============================================
# INSTRUCTIONS DE CONFIGURATION
# ============================================

# 1. Créer un compte Stripe: https://dashboard.stripe.com
# 2. Obtenir les clés API dans "Developers > API keys"
# 3. Créer les produits et prix dans "Products"
# 4. Configurer le webhook sur l'endpoint /api/stripe/webhook
# 5. Événements webhook à activer:
#    - checkout.session.completed
#    - customer.subscription.created
#    - customer.subscription.updated
#    - customer.subscription.deleted
#    - customer.subscription.trial_will_end
#    - invoice.payment_succeeded
#    - invoice.payment_failed
# 6. Obtenir le secret webhook et l'ajouter à STRIPE_WEBHOOK_SECRET

# SÉCURITÉ PRODUCTION:
# - Utiliser les clés LIVE (sk_live_ et pk_live_)
# - Activer HTTPS obligatoire
# - Configurer CORS correctement
# - Activer les logs Stripe pour monitoring